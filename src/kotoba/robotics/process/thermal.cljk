(ns kotoba.robotics.process.thermal
  "Transient 1-D conduction through a slab (a wall, a panel, a mould, a
  part in an oven, a packaged sample on a hot plate), time-stepped by the
  explicit FTCS scheme at a Fourier number of 0.35; the convective faces add their own bound
  so the half-cell update stays positive (2 Fo + 2 Bi Fo <= 0.9).

  Front face (x = 0): convection from a fluid at `:t-hot-c` with
  coefficient `:h-front-w-m2k`, or held at `:t-hot-c` when `:front-fixed? true`.
  Back face: convection to `:t-back-ambient-c` with `:h-back-w-m2k` (0 =
  adiabatic), or held at `:t-back-ambient-c` when `:back-fixed? true`. Initial temperature `:t0-c` throughout.

  The quantity robots and governors care about is when the back face (the
  protected side: the cold side of a fire wall, the core of a part) reaches
  `:threshold-c`, and what it reaches by `:duration-s`.

  Held to (tests): a fixed-temperature front with an adiabatic back tends
  to the front temperature; with two fixed faces the steady profile is
  linear; with both faces adiabatic the heat content never changes.")

(def defaults
  {:thickness-m 0.05 :conductivity-w-mk 1.0 :density-kg-m3 2000.0 :specific-heat-j-kgk 900.0
   :t0-c 20.0 :t-hot-c 600.0 :h-front-w-m2k 25.0 :t-back-ambient-c 20.0 :h-back-w-m2k 10.0
   :threshold-c 140.0 :duration-s 3600.0 :nodes 21 :front-fixed? false :back-fixed? false})

(defn simulate
  "Run the slab. Returns scalar quantities plus `:back-history` samples."
  [params]
  (let [{:keys [thickness-m conductivity-w-mk density-kg-m3 specific-heat-j-kgk t0-c t-hot-c
                h-front-w-m2k t-back-ambient-c h-back-w-m2k threshold-c duration-s nodes
                front-fixed? back-fixed?]}
        (merge defaults params)
        n (long nodes)
        dx (/ thickness-m (dec n))
        alpha (/ conductivity-w-mk (* density-kg-m3 specific-heat-j-kgk))
        ;; half-cells at the faces carry half the capacity: conduction takes
        ;; 2 Fo = 0.7 of their update budget, convection at most 0.2 more
        dt (min (/ (* 0.35 dx dx) alpha)
                (if (and (not front-fixed?) (pos? h-front-w-m2k)) (/ (* 0.1 density-kg-m3 specific-heat-j-kgk dx) h-front-w-m2k) 1e30)
                (if (and (not back-fixed?) (pos? h-back-w-m2k)) (/ (* 0.1 density-kg-m3 specific-heat-j-kgk dx) h-back-w-m2k) 1e30))
        steps (long (Math/ceil (/ duration-s dt)))
        cap (* density-kg-m3 specific-heat-j-kgk dx)   ; J/(m^2 K) per interior node
        k conductivity-w-mk
        step-fn (fn [T]
                  (let [last-i (dec n)]
                    (mapv (fn [i]
                            (let [Ti (nth T i)
                                  q-left (if (zero? i)
                                           (* h-front-w-m2k (- t-hot-c Ti))
                                           (* (/ k dx) (- (nth T (dec i)) Ti)))
                                  q-right (if (= i last-i)
                                            (* h-back-w-m2k (- t-back-ambient-c Ti))
                                            (* (/ k dx) (- (nth T (inc i)) Ti)))
                                  c (if (or (zero? i) (= i last-i)) (/ cap 2.0) cap)]
                              (cond (and front-fixed? (zero? i)) (double t-hot-c)
                                    (and back-fixed? (= i last-i)) (double t-back-ambient-c)
                                    :else (+ Ti (* dt (/ (+ q-left q-right) c))))))
                          (range n))))
        sample (max 1 (quot steps 60))]
    (loop [s 0 T (cond-> (vec (repeat n (double t0-c)))
                    front-fixed? (assoc 0 (double t-hot-c))
                    back-fixed? (assoc (dec n) (double t-back-ambient-c)))
           cross nil hist []]
      (let [back (peek T)
            cross (or cross (when (>= back threshold-c) (* s dt)))
            hist (if (zero? (mod s sample)) (conj hist [(* s dt) back]) hist)]
        (if (>= s steps)
          {:time-to-threshold-s cross
           :reached-threshold? (boolean cross)
           :final-back-c back
           :final-front-c (first T)
           :mean-c (/ (reduce + T) n)
           :heat-content-j-m2 (* cap (- (reduce + T) (/ (+ (first T) (peek T)) 2.0)))
           :dt-s dt :steps steps
           :back-history hist}
          (recur (inc s) (step-fn T) cross hist))))))
